---
import { ThemeToggle } from "./ThemeToggle"
import { BOARD_ACTIONS_ID } from "../lib/domIds"

type Props = {
  /** Renders the mount point the board island portals its Export/Clear controls into. */
  boardActions?: boolean
}

const { boardActions = false } = Astro.props
---

<header class="flex items-end justify-between gap-4 py-4 md:py-6">
  <a href="/" class="group flex flex-col">
    <span
      class="inline-flex items-center gap-1 font-serif text-lg font-medium tracking-tight md:text-xl group-hover:text-ink/75"
    >
      mockingboard
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20.95 20.65"
        class="size-3"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width=".2"
        aria-hidden="true"
      >
        <path d="M8.97.5l-2.5,6,4,13.4,4-13.4L11.97.5"></path>
        <path
          d="M15.47.5c.6,0,1.2.3,1.6.8l3,4c.5.7.5,1.7,0,2.4l-8,11c-1.7,2-1.81,1.7-2.79.48-.6-.75-.66-.8-.82-1.05L.88,7.7c-.5-.7-.5-1.7,0-2.4L3.88,1.3c.4-.5,1-.8,1.6-.8h10Z"
          stroke-width="1"></path>
        <path d="M.47,6.5h20"></path>
        <line x1="14.47" y1="6.5" x2="16.18" y2=".9"></line>
        <line x1="6.47" y1="6.5" x2="4.78" y2=".9"></line>
      </svg>
    </span>
    <span class="font-mono text-[0.6em] tracking-tighter text-ink-muted/80">
      by floating.is
    </span>
  </a>
  <div class="flex items-center gap-2">
    {boardActions && <div id={BOARD_ACTIONS_ID} class="flex items-center gap-2" />}
    <ThemeToggle client:load />
  </div>
</header>
